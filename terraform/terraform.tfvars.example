# Not used directly by CI (the workflow passes -var flags derived at runtime,
# same pattern as infra-db/infra-k8s). Useful for local `terraform plan`.

region       = "us-east-1"
project      = "auto-repair-shop"
state_bucket = "auto-repair-shop-tfstate-<account_id>"

# Learner Lab:
# manage_iam         = false
# execution_role_arn = "arn:aws:iam::<account_id>:role/LabRole"
